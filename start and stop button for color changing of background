// start and stop button for color changing of background

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>using settimeout, setInterval and clearInterval, clerTimeout</title>
  <style>
    h1{
      text-align: center;
    }
    button{
      height: 60px;
      width: 60px;
      border-radius: 50%;
      display: block;
      margin: 10px auto;
      background: linear-gradient(rgb(83, 249, 210),blue);
      
    }
  </style>
</head>
<body>
<h1>Changing the Background color using start and stop button</h1>
<button id="start">Start</button>
<button id="stop">Stop</button>
<script>
  const randomColor = function() {
     const hex = "0123456789ABCDEF";
     let color = "#";  
     for(let i = 0; i < 6; i++) {
       color += hex[Math.floor(Math.random() * 16)];
     }
     return color;
   }
   

   
const body= document.querySelector('body');
let exist;
const startChaningColor = function(){
     if(exist){
          clearInterval(exist);
     }
     exist=setInterval(function(){
         body.style.background= randomColor(); 
     },200)
};
const stopChaningColor = function(){
     clearInterval(exist);
};



document.querySelector('#start').addEventListener('click',startChaningColor);

document.querySelector('#stop').addEventListener('click',stopChaningColor);


</script>
</body>
</html>
